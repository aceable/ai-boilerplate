{
    "name": "ai-boilerplate",
    "version": "1.0.0",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "packageManager": "npm@11.12.1",
    "overrides": {
        "js-cookie": "^3.0.7"
    },
    "scripts": {
        "postinstall": "node scripts/link-skills.js",
        "prepare": "husky",
        "dev": "next dev --port 3003",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "lint:all": "eslint . && tsc --noEmit",
        "knip:deps": "knip --dependencies",
        "licenses": "node scripts/licenses.mts",
        "licenses:check": "git ls-files --error-unmatch LICENSES.md >/dev/null && node scripts/licenses.mts && git diff --exit-code LICENSES.md",
        "setup": "./scripts/setup-all.sh",
        "setup:gh": "./scripts/setup-github-cli.sh",
        "setup:protect": "./scripts/setup-branch-protection.sh",
        "check": "./scripts/check-prerequisites.sh",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node scripts/migrate.mjs",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:branch:create": "neonctl branches create --project-id $NEON_PROJECT_ID --name",
        "db:branch:list": "neonctl branches list --project-id $NEON_PROJECT_ID",
        "db:branch:delete": "neonctl branches delete --project-id $NEON_PROJECT_ID",
        "db:branch:info": "neonctl branches get --project-id $NEON_PROJECT_ID",
        "scratch:clean": "find .scratch -type f -name '*.ts' -o -name '*.js' -o -name '*.tsx' -o -name '*.jsx' | xargs rm -f 2>/dev/null; true"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.71",
        "@ai-sdk/openai": "^4.0.83",
        "@clerk/nextjs": "^7.9.9",
        "@neondatabase/serverless": "^1.2.0",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-toast": "^1.2.23",
        "@radix-ui/react-tooltip": "^1.2.16",
        "ai": "^7.0.126",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.3",
        "drizzle-zod": "^0.8.3",
        "lucide-react": "^0.575.0",
        "next": "^16.3.8",
        "next-themes": "^0.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "ws": "^8.22.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
        "@secretlint/secretlint-rule-preset-recommend": "^9.3.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^25.9.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "@vitest/coverage-v8": "^4.1.6",
        "dotenv": "^17.3.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.8",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "knip": "6.38.0",
        "lint-staged": "^16.1.2",
        "secretlint": "^9.3.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^4.1.6"
    },
    "lint-staged": {
        "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
            "eslint --fix --no-warn-ignored"
        ],
        "*": [
            "secretlint --maskSecrets"
        ]
    }
}
