{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "buildCommand": "npm run build"
    },
    "deploy": {
        "preDeployCommand": "npm run db:migrate",
        "startCommand": "next start -p $PORT",
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 100
    }
}
