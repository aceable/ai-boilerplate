# Copy this file to .env.local and fill in your values.
# Get these from the Railway dashboard → your project → Variables.

# Neon Postgres — find in Neon dashboard > Connection Details
DATABASE_URL=postgresql://user:pass@host/db
NEON_PROJECT_ID=your-neon-project-id

# Clerk Auth — find in Clerk dashboard > API Keys.
# If you're setting this up through your company, ask them for a shared Clerk
# dev key — most orgs run one Clerk dev instance that all internal apps share.
#
# Defaults: auth is ON whenever NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is set.
#   - Leave both keys blank for local dev → app boots as public (no auth).
#   - Set NEXT_PUBLIC_ENABLE_USER_AUTH=0 to force auth off even when keys are present
#     (public production sites).
#
# Deploying to Railway: these env vars must be set in the Railway Variables tab —
# Railway does NOT read this file. NEXT_PUBLIC_* values are inlined at build
# time, so you must redeploy after adding them.
NEXT_PUBLIC_ENABLE_USER_AUTH=1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenAI — find in platform.openai.com > API Keys
OPENAI_API_KEY=sk-...

# App URL (keep as-is for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3003
