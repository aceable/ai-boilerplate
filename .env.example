# Copy to .env.local. Hosting providers (Railway, Vercel) do NOT read this file —
# set vars in their UI. NEXT_PUBLIC_* values are inlined at build; redeploy after changing them.
# Full auth + theme details: AGENTS.md.

# Neon Postgres — Neon dashboard > Connection Details
DATABASE_URL=postgresql://user:pass@host/db
NEON_PROJECT_ID=your-neon-project-id

# Clerk Auth — Clerk dashboard > API Keys.
# USE TEST KEYS (pk_test_* / sk_test_*) for local dev AND non-prod deploys.
# pk_live_* keys are domain-locked and will fail on any URL except your registered prod domain.
# To run without auth: leave both blank, or set NEXT_PUBLIC_ENABLE_USER_AUTH=0.
NEXT_PUBLIC_ENABLE_USER_AUTH=1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenAI — platform.openai.com > API Keys
OPENAI_API_KEY=sk-...

# App URL (local dev default)
NEXT_PUBLIC_APP_URL=http://localhost:3003
