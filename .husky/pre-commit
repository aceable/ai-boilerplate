#!/bin/sh
# Pre-commit: block commits to protected branches, then run lint-staged
# (eslint --fix on JS/TS-family files + secretlint --no-gitignore on every staged file).
#
# Override (use sparingly):  ALLOW_MAIN_COMMIT=1 git commit ...
# Skip entirely (emergencies only):  SKIP_HUSKY=1 git commit ...

[ "$SKIP_HUSKY" = "1" ] && exit 0

protected_branches="main master"
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
for b in $protected_branches; do
  if [ "$current_branch" = "$b" ]; then
    if [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
      printf '\n❌ Direct commits to "%s" are blocked.\n' "$b" >&2
      printf '   Create a feature branch:  git checkout -b feature/<short-name>\n' >&2
      printf '   Override (use sparingly):  ALLOW_MAIN_COMMIT=1 git commit ...\n\n' >&2
      exit 1
    fi
    printf '⚠️  Override active: committing directly to "%s"\n' "$b" >&2
  fi
done

npx lint-staged

# Dependency checks run only when a manifest is staged. knip blocks, since the
# author of the change can fix the finding; LICENSES.md regeneration is best effort.
if git diff --cached --name-only | grep -qE '(^|/)package\.json$|^package-lock\.json$|^knip\.jsonc$'; then
  printf '\n🧹 Checking dependencies (knip)\n'
  npm run knip:deps --silent || exit 1
fi

if git diff --cached --name-only | grep -qE '(^|/)package\.json$|^package-lock\.json$'; then
  printf '\n⚖️  Regenerating LICENSES.md\n'
  if npm run licenses --silent; then
    git add LICENSES.md
  else
    printf '⚠️  LICENSES.md was not regenerated (not blocking). Run npm run licenses later.\n' >&2
  fi
fi
