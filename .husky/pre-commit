#!/bin/sh
# Pre-commit: block commits to protected branches, then run lint-staged
# (eslint --fix on TS/TSX + secretlint on every staged file).
#
# Override (audit-logged):  ALLOW_MAIN_COMMIT=1 git commit ...
# Skip entirely (emergencies only):  SKIP_HUSKY=1 git commit ...

[ "$SKIP_HUSKY" = "1" ] && exit 0

protected_branches="main master"
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
for b in $protected_branches; do
  if [ "$current_branch" = "$b" ]; then
    if [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
      printf '\n❌ Direct commits to "%s" are blocked.\n' "$b" >&2
      printf '   Create a feature branch:  git checkout -b feature/<short-name>\n' >&2
      printf '   Override (audit-logged):  ALLOW_MAIN_COMMIT=1 git commit ...\n\n' >&2
      exit 1
    fi
    printf '⚠️  Override active: committing directly to "%s"\n' "$b" >&2
  fi
done

npx lint-staged
